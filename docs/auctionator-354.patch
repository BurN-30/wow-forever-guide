diff -ruN a/Auctionator/Source/Utilities/DBKeyFromLink.lua b/Auctionator/Source/Utilities/DBKeyFromLink.lua
--- a/Auctionator/Source/Utilities/DBKeyFromLink.lua
+++ b/Auctionator/Source/Utilities/DBKeyFromLink.lua
@@ -57,6 +57,10 @@
             if index then
               callback({"gr:" .. itemID .. ":" .. index, basicKey})
             elseif #Auctionator.Utilities.SuffixesExtraChecks > 0 then
+              -- [pack patch] `seen` was a global never set back to false: after one item matched here,
+              -- an item with a suffix no check matches never called back (no price). Local, as in
+              -- Source_ModernAH/Utilities/DBKeyFromBrowseResult.lua.
+              local seen = false
               for _, bonusID in ipairs(Auctionator.Utilities.SuffixesExtraChecks) do
                 local newLink = "item:" .. itemID .. string.rep(":", 12) .. "1:" .. bonusID
                 local newName = C_Item.GetItemNameByID(newLink)
diff -ruN a/Auctionator/Source/Variables/Main.lua b/Auctionator/Source/Variables/Main.lua
--- a/Auctionator/Source/Variables/Main.lua
+++ b/Auctionator/Source/Variables/Main.lua
@@ -175,8 +175,11 @@
     local new = {suffixes = true}
     for key, value in pairs(AUCTIONATOR_PRICE_DATABASE[realm]) do
       local p1, p2 = key:match("(gr:%d+:)([%a%s']+)")
-      if p1 and p2 then
-        local newKey = p1 .. tIndexOf(Auctionator.Utilities.SuffixLabels, p2)
+      -- [pack patch] A label this version does not list (tIndexOf: nil) keeps its key, instead of a
