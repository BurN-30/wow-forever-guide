  when onquest 4363
  zone Burning Steppes
  goto 84.4,68.3 "Morgan's Vigil flight master"
  fly "Ironforge"
  zone Ironforge

step Ironforge: King Magni Bronzebeard
  when onquest 4363
  zone Ironforge
  turnin 4363                         -- King Magni Bronzebeard

step Kharanos: Ragnar Thunderbrew
  when complete 4126
  zone Dun Morogh
  turnin 4126                         -- Ragnar Thunderbrew

step Blackrock Depths: quests not done
  label brd-end
  when done brd-start
  tip What is left of Blackrock Depths in the quest log is for another run: keep it for one, or drop it to free the log.
  abandon 4123 optional
  abandon 4282 optional
  abandon 4322 optional
  abandon 4362 optional
  abandon 4263 optional
  abandon 4024 optional
  abandon 4136 optional
  abandon 4126 optional
  abandon 4286 optional
